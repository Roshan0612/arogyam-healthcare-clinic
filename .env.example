# Copy to .env.local for development. Add the same variables in Vercel settings.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Unique private clinic-admin password, at least 16 characters.
ADMIN_PASSWORD=
# Exact site origin, no path. Use http://localhost:3000 locally.
APP_URL=http://localhost:3000
